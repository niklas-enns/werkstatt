{
  "description": "werkstatt: Akzeptanztests schützen; im Orchestrator verify vor dem Abschluss erzwingen",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/werkstatt.py\" pre-tool", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/werkstatt.py\" stop", "timeout": 600 }
        ]
      }
    ]
  }
}
